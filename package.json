{
  "name": "rnawiki",
  "version": "2.0.0",
  "private": true,
  "description": "RNAwiki — see where the evidence actually ends. The Proof Boundary between what research measured and what people claim from it.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts && tsx scripts/seed-legacy-redirects.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:prose": "tsx scripts/check-prose.ts",
    "gate": "npm run typecheck && npm run lint && npm run check:prose && npm run test:unit && npm run test:integration && npm run build"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.11.5",
    "zod": "^3.24.1",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.12.0",
    "iron-session": "^8.0.4",
    "bcryptjs": "^2.4.3",
    "isomorphic-dompurify": "^2.16.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=20"
  }
}
