# Postgres connection. On Railway, use the internal DATABASE_URL in production
# and DATABASE_PUBLIC_URL for any script run from outside Railway's network.
DATABASE_URL=postgresql://user:password@localhost:5432/rnawiki

# TLS for the database connection (db/ssl.ts). localhost, 127.0.0.1 and *.railway.internal
# connect without TLS; every other host gets TLS with the certificate VERIFIED. Railway's
# Postgres serves a self-signed certificate and publishes no CA, so a connection over
# DATABASE_PUBLIC_URL needs the server certificate here:
PGSSLROOTCERT=
# Last resort only. Setting this to `true` encrypts the connection without authenticating it,
# which means anything able to intercept the path can read the credentials above. It prints a
# warning on every start. Prefer PGSSLROOTCERT.
DATABASE_SSL_NO_VERIFY=

# Session encryption key for admin/editor/reviewer login (iron-session).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public site URL used for canonical links, OG images, sitemap, embeds, API responses.
SITE_URL=https://rnawiki.com
SITE_NAME=RNAwiki

# Seed/bootstrap credentials for the first administrator account.
# Only read by scripts/seed.ts; unset after first run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: NCBI E-utilities API key (higher rate limit for DOI/PMID metadata import).
NCBI_EUTILS_API_KEY=

# Optional: transactional email for evidence-change follow alerts. Feature-flagged off
# (subscriptions disabled) when unset.
RESEND_API_KEY=
EMAIL_FROM=RNAwiki <hello@rnawiki.com>

# Privacy-conscious analytics (feature-flagged off when unset).
ANALYTICS_WRITE_KEY=
