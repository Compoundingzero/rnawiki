# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development. db/ssl.ts disables TLS only for localhost / 127.0.0.1 / ::1 and
# *.railway.internal; every other host gets TLS with the certificate VERIFIED.
DATABASE_URL=postgresql://postgres@localhost:5432/rnawiki_dev

# Railway's Postgres template serves a self-signed certificate and publishes no CA, so verification
# against the PUBLIC host cannot succeed out of the box. Point this at the server's certificate for
# any script run from outside Railway's network (migrations, ingest, backups).
# PGSSLROOTCERT=/absolute/path/to/server-ca.pem

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Must be at least 32 characters or lib/session.ts throws on the first request touching a session.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-thirty-two-characters

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
SITE_NAME=RNAWiki
# Public GA4 web-stream identifier. Blank or malformed values disable analytics entirely. RNAWiki
# loads the tag only after a visitor allows analytics and never transmits URL query values.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Crawl access fails closed unless this (or the platform's deployment marker) is exactly
# `production`. Use `staging`/`development` everywhere else.
SEO_DEPLOYMENT_ENV=development

# IndexNow remains a no-op unless this is true, the deployment guard above is canonical production,
# and a valid public ownership key is present. Keys use 8-128 ASCII letters, digits or hyphens.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
# Defaults to https://rnawiki.com/indexnow-key.txt, which the app serves only when enabled on the
# canonical production deployment. Override only when the same public key is hosted at this exact
# same-origin .txt URL.
# INDEXNOW_KEY_LOCATION=https://rnawiki.com/indexnow-key.txt
INDEXNOW_TIMEOUT_MS=5000
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
# Where the downloaded openFDA / PubChem / DSLD corpora live. ~1.9 GB. Defaults to a scratch
# directory; set it to somewhere durable if you do not want to re-download after a reboot.
# RNAWIKI_INGEST_DATA=/var/lib/rnawiki/ingest
